# voice-memo configuration — plain bash, sourced by the script on every run.

# AI cleanup pass: removes filler words, tidies punctuation/capitalization
# before the transcript hits the clipboard. Falls back to the raw transcript
# on any failure or timeout.
VOICE_MEMO_AI=1

# Engine: "claude" (fast, works today) or "codex" (gpt-6-astra — your pick,
# but the Codex quota is exhausted until 2026-09-23; flip then if you prefer).
VOICE_MEMO_AI_ENGINE=claude

# Optional model override per engine (default: haiku / gpt-6-astra).
# VOICE_MEMO_AI_MODEL=haiku

# Full override: any command; transcript on stdin, cleaned text on stdout.
# VOICE_MEMO_AI_CMD='my-cleaner --fast'
