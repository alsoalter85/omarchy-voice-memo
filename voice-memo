#!/usr/bin/env bash
# voice-memo — toggle voice recording on Omarchy/Hyprland, with local transcription.
#
# First run:  starts recording the default PipeWire source to a WAV in ~/Recordings
#             and shows a persistent "Recording…" notification.
# Second run: stops recording, encodes to MP3 (libmp3lame VBR ~165k), deletes the
#             WAV, and immediately copies a file reference to the clipboard. Then it
#             transcribes locally via voxtype (whisper.cpp), saves the transcript
#             next to the MP3 (.txt), and replaces the clipboard with the transcript
#             text. Two-stage clipboard: file ref first, transcript when ready.
#
# Deps: pw-record (pipewire), ffmpeg, wl-copy (wl-clipboard), omarchy (notifications),
#       voxtype (transcription; optional — falls back to file-reference clipboard).
#
# Env knobs:
#   VOICE_MEMO_DIR        output directory        (default: ~/Recordings)
#   VOICE_MEMO_TRANSCRIBE 1 = transcribe, 0 = off (default: 1)
#   VOICE_MEMO_CLIPBOARD  "text" = transcript, "file" = mp3 file reference
#                         (default: text when transcription works, else file)
#   VOICE_MEMO_REPLACEMENTS  find/replace map applied to transcripts
#                         (default: ~/.config/voice-memo/replacements)
#   VOICE_MEMO_TRASH_DIR  where 'voice-memo cancel' (ESC) saves trashed takes
#                         (default: /tmp/recordings-trashed — auto-empties on reboot)
#   VOICE_MEMO_AUTOPASTE  1 = paste the transcript into the focused window when
#                         transcription finishes, 0 = clipboard only (default: 1)
#   VOICE_MEMO_PASTE_KEYS key combo for autopaste, modifiers joined with '+'
#                         (default: ctrl+v; use ctrl+shift+v for terminals)
#   VOICE_MEMO_AI         1 = run the transcript through an AI cleanup pass
#                         (filler words, punctuation) before clipboard/paste
#   VOICE_MEMO_AI_ENGINE  pi (default) | claude | codex
#   VOICE_MEMO_AI_PROVIDER Pi provider (default: openrouter)
#   VOICE_MEMO_AI_MODEL   Pi default: google/gemini-3.8-flash; reasoning off
#   VOICE_MEMO_AI_CMD     full override: any command, transcript on stdin,
#                         cleaned text on stdout
#   VOICE_MEMO_AI_TIMEOUT seconds before giving up and keeping the raw
#                         transcript (default: 60)
#
# Deps for autopaste: wtype.
#
# Subcommands:
#   voice-memo cancel   stop the current recording and trash it (no transcript,
#                       clipboard untouched). Bound to ESC via a consuming bind
#                       that is armed only while recording, so ESC never leaks
#                       into the focused app. Silent no-op when not recording.
#
# Replacements file format (one per line, case-insensitive substring match):
#   scale stack = Scalestack
#   # comments and blank lines are ignored

set -u

# Optional user config (plain bash assignments) — see config.example.
VOICE_MEMO_CONFIG="${VOICE_MEMO_CONFIG:-$HOME/.config/voice-memo/config}"
[[ -f $VOICE_MEMO_CONFIG ]] && source "$VOICE_MEMO_CONFIG"

OUT_DIR="${VOICE_MEMO_DIR:-$HOME/Recordings}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/voice-memo.state"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/voice-memo.lock"
NOTIF_ID=4210

notify() {
  omarchy notification send --app-name "voice-memo" -r "$NOTIF_ID" "$@" >/dev/null 2>&1 || true
}

# Serialize toggle presses so a fast double-press can't race itself.
exec 9>"$LOCK"
flock -w 2 9 || exit 1

start_recording() {
  mkdir -p "$OUT_DIR"
  local wav="$OUT_DIR/voice-$(date +%Y%m%d-%H%M%S).wav"

  # 9>&- : the recorder must not inherit the lock fd, or it holds the flock forever.
  setsid pw-record "$wav" 9>&- &
  local pid=$!

  if ! kill -0 "$pid" 2>/dev/null; then
    notify -u critical -t 6000 "Voice memo failed" "pw-record could not start (mic available?)"
    exit 1
  fi

  echo "$pid $wav" > "$STATE"
  notify -u critical -t 0 "● Recording…" "SUPER+SHIFT+R to stop · ESC to trash"

  # Arm the consuming ESC bind (defined in ~/.config/hypr/bindings.lua, disabled
  # by default): ESC now trashes the take and is NOT delivered to the focused
  # app. Disarmed again in kill_recorder().
  hyprctl eval 'voice_memo_esc:set_enabled(true)' >/dev/null 2>&1 || true
}

# Transcribe an audio file with voxtype (whisper.cpp). Prints transcript on stdout,
# empty on failure. Voxtype wants 16 kHz mono WAV, so convert via ffmpeg first.
transcribe() {
  local src="$1" tmpwav
  tmpwav=$(mktemp /tmp/voice-memo-XXXXXX.wav) || return 1
  ffmpeg -y -loglevel error -i "$src" -ar 16000 -ac 1 "$tmpwav" || { rm -f "$tmpwav"; return 1; }

  # stdout noise ("Loading audio file:", "Audio format:", "Processing …") is
  # filtered out; remaining non-empty lines are the transcript.
  voxtype -q transcribe "$tmpwav" 2>/dev/null \
    | sed 's/\x1b\[[0-9;]*m//g' \
    | grep -v -e '^Loading audio file:' -e '^Audio format:' -e '^Processing ' \
    | sed '/^[[:space:]]*$/d'

  rm -f "$tmpwav"
}

# Case-insensitive find/replace over the transcript, from a "from = to" map file.
# (voxtype's own text.replacements only runs in its daemon output path, not in
# 'voxtype transcribe', so we do it here.)
apply_replacements() {
  local file="$1" text="$2" line from to
  [[ -f $file ]] || { printf '%s' "$text"; return; }
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*($|#) ]] && continue   # blank lines / comments
    [[ $line == *=* ]] || continue
    from="${line%%=*}"; to="${line#*=}"
    from="${from#"${from%%[![:space:]]*}"}"; from="${from%"${from##*[![:space:]]}"}"  # trim
    to="${to#"${to%%[![:space:]]*}"}"; to="${to%"${to##*[![:space:]]}"}"
    [[ -n $from ]] || continue
    # escape regex specials in <from>, escape / and & in both sides, then global
    # case-insensitive substitute (GNU sed 'I' flag)
    from=$(printf '%s' "$from" | sed 's|[\\/.^$*[]|\\&|g')
    to=$(printf '%s' "$to" | sed 's|[\\&/]|\\&|g')
    text=$(printf '%s' "$text" | sed "s/$from/$to/gi")
  done < "$file"
  printf '%s' "$text"
}

# Stop the recorder described by the state file and clean up the state.
# Prints the finalized WAV path. rc 1 = stale state (recorder already dead),
# rc 2 = no audio captured. SIGINT lets pw-record finalize the WAV header.
kill_recorder() {
  local pid wav
  read -r pid wav < "$STATE" || return 1
  rm -f "$STATE"
  # Disarm the consuming ESC bind (safe no-op when already disarmed).
  hyprctl eval 'voice_memo_esc:set_enabled(false)' >/dev/null 2>&1 || true
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$wav"
    return 1
  fi
  kill -INT "$pid" 2>/dev/null
  for _ in $(seq 30); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -9 "$pid" 2>/dev/null
  if [[ ! -s "$wav" ]]; then
    rm -f "$wav"
    return 2
  fi
  printf '%s' "$wav"
}

# Paste the clipboard into the focused window via wtype. Key combo comes from
# VOICE_MEMO_PASTE_KEYS (e.g. "ctrl+shift+v"); last token is the key.
autopaste() {
  command -v wtype >/dev/null 2>&1 || return 1
  local combo="${VOICE_MEMO_PASTE_KEYS:-ctrl+v}"
  local -a parts args=()
  local m key
  IFS='+' read -ra parts <<< "$combo"
  key="${parts[-1]}"
  unset 'parts[-1]'
  for m in "${parts[@]}"; do args+=(-M "$m"); done
  args+=(-k "$key")
  for m in "${parts[@]}"; do args+=(-m "$m"); done
  sleep 0.15   # let the clipboard owner settle and any stop-key release land
  wtype "${args[@]}" >/dev/null 2>&1 || true
}

AI_PROMPT='Clean up this voice-memo transcript: remove filler words, fix punctuation and capitalization, keep the original language and meaning, do not summarize. Output ONLY the cleaned text.'

# Optional AI cleanup pass. Prints the cleaned transcript, empty on any failure
# (caller keeps the raw transcript as fallback).
ai_cleanup() {
  local timeout_s="${VOICE_MEMO_AI_TIMEOUT:-60}"
  local context_file="${VOICE_MEMO_AI_CONTEXT_FILE:-$HOME/.config/voice-memo/cleanup-context.md}"
  local context="" prompt="$AI_PROMPT"
  # Read as data, never source or evaluate this user-editable Markdown.
  if [[ -f "$context_file" && -r "$context_file" ]]; then
    context=$(<"$context_file")
    if [[ -n "$context" ]]; then
      prompt+=$'\n\nUser cleanup preferences (apply only to the transcript; do not add biographical facts or change its meaning):\n'
      prompt+="$context"
    fi
  fi
  if [[ -n "${VOICE_MEMO_AI_CMD:-}" ]]; then
    printf '%s' "$1" | timeout "$timeout_s" bash -c "$VOICE_MEMO_AI_CMD" 2>/dev/null
    return
  fi
  case "${VOICE_MEMO_AI_ENGINE:-pi}" in
    pi)
      command -v pi >/dev/null 2>&1 || return 1
      local cleaned
      cleaned=$(printf '%s' "$1" | timeout "$timeout_s" pi --print --mode text \
        --no-session --no-tools --no-extensions --no-skills \
        --no-context-files --no-prompt-templates \
        --provider "${VOICE_MEMO_AI_PROVIDER:-openrouter}" \
        --model "${VOICE_MEMO_AI_MODEL:-google/gemini-3.8-flash}" \
        --thinking off --system-prompt "$prompt" 2>/dev/null) || return 1
      printf '%s' "$cleaned"
      ;;
    claude)
      command -v claude >/dev/null 2>&1 || return 1
      printf '%s' "$1" | timeout "$timeout_s" claude -p \
        --model "${VOICE_MEMO_AI_MODEL:-haiku}" "$prompt" 2>/dev/null
      ;;
    codex)
      command -v codex >/dev/null 2>&1 || return 1
      local out cleaned
      out=$(mktemp /tmp/voice-memo-ai-XXXXXX) || return 1
      ( cd /tmp && printf '%s' "$1" | timeout "$timeout_s" codex exec --ephemeral \
          -s read-only --skip-git-repo-check \
          -m "${VOICE_MEMO_AI_MODEL:-gpt-6-astra}" -c 'model_reasoning_effort="low"' \
          -o "$out" "$prompt" >/dev/null 2>&1 )
      cleaned=""
      [[ -s $out ]] && cleaned=$(<"$out")   # $(<) strips trailing newlines
      rm -f "$out"
      printf '%s' "$cleaned"
      ;;
  esac
}

# ESC path: stop and stash the take in the trash dir. No transcription, no
# clipboard changes; silent no-op when there is nothing to trash.
trash_recording() {
  local wav mp3 trash
  wav=$(kill_recorder) || exit 0

  trash="${VOICE_MEMO_TRASH_DIR:-/tmp/recordings-trashed}"
  mkdir -p "$trash"
  mp3="$trash/$(basename "${wav%.wav}").mp3"

  if ffmpeg -y -loglevel error -i "$wav" -codec:a libmp3lame -q:a 4 "$mp3"; then
    rm -f "$wav"
    notify -t 6000 "Voice memo trashed" "$mp3"
  else
    rm -f "$wav"
    notify -u critical -t 6000 "Voice memo failed" "ffmpeg could not encode the recording"
  fi
}

stop_recording() {
  local wav rc
  wav=$(kill_recorder) && rc=0 || rc=$?
  case $rc in
    1) notify -t 5000 "Voice memo discarded" "Recorder was not running (stale state cleaned up)"; exit 1 ;;
    2) notify -u critical -t 6000 "Voice memo failed" "No audio captured"; exit 1 ;;
  esac

  local mp3="${wav%.wav}.mp3"
  if ! ffmpeg -y -loglevel error -i "$wav" -codec:a libmp3lame -q:a 4 "$mp3"; then
    rm -f "$wav"
    notify -u critical -t 6000 "Voice memo failed" "ffmpeg could not encode the recording"
    exit 1
  fi
  rm -f "$wav"

  local secs dur size
  secs=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$mp3" 2>/dev/null | cut -d. -f1)
  dur=$(printf '%02d:%02d' "$(( ${secs:-0} / 60 ))" "$(( ${secs:-0} % 60 ))")
  size=$(stat -c %s "$mp3" | numfmt --to=iec --suffix=B)

  # Clipboard stage 1: MP3 file reference, available immediately.
  # (9>&- : wl-copy stays alive to serve the clipboard; don't let it hold the lock.)
  printf 'file://%s\r\n' "$mp3" | wl-copy -t text/uri-list 9>&-

  # Transcribe (swap the notification to show progress — the model load can take a moment).
  local transcript=""
  if [[ "${VOICE_MEMO_TRANSCRIBE:-1}" == "1" ]] && command -v voxtype >/dev/null 2>&1; then
    notify -t 0 "Voice memo saved" "Transcribing…"
    transcript=$(transcribe "$mp3")
    if [[ -n "$transcript" ]]; then
      transcript=$(apply_replacements "${VOICE_MEMO_REPLACEMENTS:-$HOME/.config/voice-memo/replacements}" "$transcript")
      if [[ "${VOICE_MEMO_AI:-0}" == "1" ]]; then
        notify -t 0 "Voice memo saved" "Polishing with AI…"
        local polished
        polished=$(ai_cleanup "$transcript")
        [[ -n "$polished" ]] && transcript="$polished"
      fi
      printf '%s\n' "$transcript" > "${mp3%.mp3}.txt"
    fi
  fi

  # Clipboard stage 2: replace the file reference with the transcript text
  # (skipped in file mode or when transcription produced nothing).
  if [[ -n "$transcript" && "${VOICE_MEMO_CLIPBOARD:-text}" != "file" ]]; then
    printf '%s' "$transcript" | wl-copy 9>&-
    [[ "${VOICE_MEMO_AUTOPASTE:-1}" == "1" ]] && autopaste
  fi

  if [[ -n "$transcript" ]]; then
    local preview
    preview=$(printf '%s' "$transcript" | tr '\n' ' ' | cut -c1-90)
    [[ ${#transcript} -gt 90 ]] && preview+="…"
    notify -t 10000 "Voice memo saved" "$(basename "$mp3") · $dur · $size
\"$preview\"
Copied to clipboard"
  else
    notify -t 8000 "Voice memo saved" "$(basename "$mp3") · $dur · $size
File reference copied to clipboard (no transcript)"
  fi
}

if [[ "${1:-}" == "cancel" ]]; then
  [[ -f "$STATE" ]] && trash_recording
  exit 0
fi

if [[ -f "$STATE" ]]; then
  stop_recording
else
  start_recording
fi
