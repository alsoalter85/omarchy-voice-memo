#!/usr/bin/env bash
# voice-memo — toggle voice recording on Omarchy/Hyprland, with local transcription.
#
# First run:  starts recording the default PipeWire source to a WAV in ~/Recordings
#             and shows a persistent "Recording…" notification.
# Second run: stops recording, encodes to MP3 (libmp3lame VBR ~165k), deletes the
#             WAV, and immediately copies a file reference to the clipboard. Then it
#             transcribes locally via voxtype (whisper.cpp), saves the transcript
#             next to the MP3 (.txt), and replaces the clipboard with the transcript
#             text. Two-stage clipboard: file ref first, transcript when ready.
#
# Deps: pw-record (pipewire), ffmpeg, wl-copy (wl-clipboard), omarchy (notifications),
#       voxtype (transcription; optional — falls back to file-reference clipboard).
#
# Env knobs:
#   VOICE_MEMO_DIR        output directory        (default: ~/Recordings)
#   VOICE_MEMO_TRANSCRIBE 1 = transcribe, 0 = off (default: 1)
#   VOICE_MEMO_CLIPBOARD  "text" = transcript, "file" = mp3 file reference
#                         (default: text when transcription works, else file)
#   VOICE_MEMO_REPLACEMENTS  find/replace map applied to transcripts
#                         (default: ~/.config/voice-memo/replacements)
#
# Replacements file format (one per line, case-insensitive substring match):
#   scale stack = Scalestack
#   # comments and blank lines are ignored

set -u

OUT_DIR="${VOICE_MEMO_DIR:-$HOME/Recordings}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/voice-memo.state"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/voice-memo.lock"
NOTIF_ID=4210

notify() {
  omarchy notification send --app-name "voice-memo" -r "$NOTIF_ID" "$@" >/dev/null 2>&1 || true
}

# Serialize toggle presses so a fast double-press can't race itself.
exec 9>"$LOCK"
flock -w 2 9 || exit 1

start_recording() {
  mkdir -p "$OUT_DIR"
  local wav="$OUT_DIR/voice-$(date +%Y%m%d-%H%M%S).wav"

  # 9>&- : the recorder must not inherit the lock fd, or it holds the flock forever.
  setsid pw-record "$wav" 9>&- &
  local pid=$!

  if ! kill -0 "$pid" 2>/dev/null; then
    notify -u critical -t 6000 "Voice memo failed" "pw-record could not start (mic available?)"
    exit 1
  fi

  echo "$pid $wav" > "$STATE"
  notify -u critical -t 0 "● Recording…" "Press SUPER+SHIFT+R to stop"
}

# Transcribe an audio file with voxtype (whisper.cpp). Prints transcript on stdout,
# empty on failure. Voxtype wants 16 kHz mono WAV, so convert via ffmpeg first.
transcribe() {
  local src="$1" tmpwav
  tmpwav=$(mktemp /tmp/voice-memo-XXXXXX.wav) || return 1
  ffmpeg -y -loglevel error -i "$src" -ar 16000 -ac 1 "$tmpwav" || { rm -f "$tmpwav"; return 1; }

  # stdout noise ("Loading audio file:", "Audio format:", "Processing …") is
  # filtered out; remaining non-empty lines are the transcript.
  voxtype -q transcribe "$tmpwav" 2>/dev/null \
    | sed 's/\x1b\[[0-9;]*m//g' \
    | grep -v -e '^Loading audio file:' -e '^Audio format:' -e '^Processing ' \
    | sed '/^[[:space:]]*$/d'

  rm -f "$tmpwav"
}

# Case-insensitive find/replace over the transcript, from a "from = to" map file.
# (voxtype's own text.replacements only runs in its daemon output path, not in
# 'voxtype transcribe', so we do it here.)
apply_replacements() {
  local file="$1" text="$2" line from to
  [[ -f $file ]] || { printf '%s' "$text"; return; }
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*($|#) ]] && continue   # blank lines / comments
    [[ $line == *=* ]] || continue
    from="${line%%=*}"; to="${line#*=}"
    from="${from#"${from%%[![:space:]]*}"}"; from="${from%"${from##*[![:space:]]}"}"  # trim
    to="${to#"${to%%[![:space:]]*}"}"; to="${to%"${to##*[![:space:]]}"}"
    [[ -n $from ]] || continue
    # escape regex specials in <from>, escape / and & in both sides, then global
    # case-insensitive substitute (GNU sed 'I' flag)
    from=$(printf '%s' "$from" | sed 's|[\\/.^$*[]|\\&|g')
    to=$(printf '%s' "$to" | sed 's|[\\&/]|\\&|g')
    text=$(printf '%s' "$text" | sed "s/$from/$to/gi")
  done < "$file"
  printf '%s' "$text"
}

stop_recording() {
  local pid wav
  read -r pid wav < "$STATE"
  rm -f "$STATE"

  # State file pointing at a dead recorder = stale; clean up and bail.
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$wav"
    notify -t 5000 "Voice memo discarded" "Recorder was not running (stale state cleaned up)"
    exit 1
  fi

  # SIGINT lets pw-record finalize the WAV header; give it up to 3s.
  kill -INT "$pid" 2>/dev/null
  for _ in $(seq 30); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -9 "$pid" 2>/dev/null

  [[ -s "$wav" ]] || { notify -u critical -t 6000 "Voice memo failed" "No audio captured"; exit 1; }

  local mp3="${wav%.wav}.mp3"
  if ! ffmpeg -y -loglevel error -i "$wav" -codec:a libmp3lame -q:a 4 "$mp3"; then
    rm -f "$wav"
    notify -u critical -t 6000 "Voice memo failed" "ffmpeg could not encode the recording"
    exit 1
  fi
  rm -f "$wav"

  local secs dur size
  secs=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$mp3" 2>/dev/null | cut -d. -f1)
  dur=$(printf '%02d:%02d' "$(( ${secs:-0} / 60 ))" "$(( ${secs:-0} % 60 ))")
  size=$(stat -c %s "$mp3" | numfmt --to=iec --suffix=B)

  # Clipboard stage 1: MP3 file reference, available immediately.
  # (9>&- : wl-copy stays alive to serve the clipboard; don't let it hold the lock.)
  printf 'file://%s\r\n' "$mp3" | wl-copy -t text/uri-list 9>&-

  # Transcribe (swap the notification to show progress — the model load can take a moment).
  local transcript=""
  if [[ "${VOICE_MEMO_TRANSCRIBE:-1}" == "1" ]] && command -v voxtype >/dev/null 2>&1; then
    notify -t 0 "Voice memo saved" "Transcribing…"
    transcript=$(transcribe "$mp3")
    if [[ -n "$transcript" ]]; then
      transcript=$(apply_replacements "${VOICE_MEMO_REPLACEMENTS:-$HOME/.config/voice-memo/replacements}" "$transcript")
      printf '%s\n' "$transcript" > "${mp3%.mp3}.txt"
    fi
  fi

  # Clipboard stage 2: replace the file reference with the transcript text
  # (skipped in file mode or when transcription produced nothing).
  if [[ -n "$transcript" && "${VOICE_MEMO_CLIPBOARD:-text}" != "file" ]]; then
    printf '%s' "$transcript" | wl-copy 9>&-
  fi

  if [[ -n "$transcript" ]]; then
    local preview
    preview=$(printf '%s' "$transcript" | tr '\n' ' ' | cut -c1-90)
    [[ ${#transcript} -gt 90 ]] && preview+="…"
    notify -t 10000 "Voice memo saved" "$(basename "$mp3") · $dur · $size
\"$preview\"
Copied to clipboard"
  else
    notify -t 8000 "Voice memo saved" "$(basename "$mp3") · $dur · $size
File reference copied to clipboard (no transcript)"
  fi
}

if [[ -f "$STATE" ]]; then
  stop_recording
else
  start_recording
fi
